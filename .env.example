# ---------------------------------------------------------------------------
# HH Goa Voice RAG — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# is committed. NEVER commit real keys.
#
#   cp .env.example .env
#
# Format: bare KEY=VALUE, no quotes, no `export`. Real environment variables
# always win over .env values (see backend/rag/stt.py:load_env).
# ---------------------------------------------------------------------------

# === Speech-to-text (REQUIRED for the voice path) =========================
# Sarvam is the chosen STT provider (task allows Sarvam OR ElevenLabs).
# NOTE: the historic spelling in this project is SARAVAM_API_KEY. Both the
# correct and historic spellings are accepted; set either one.
SARVAM_API_KEY=
SARAVAM_API_KEY=

# sarvam | echo   (`echo` = offline mock, no network, used by tests)
STT_PROVIDER=sarvam
# Primary expected input language. hi-IN | mr-IN | en-IN | unknown
STT_LANGUAGE=hi-IN


# === Answer generation LLM (REQUIRED) =====================================
# Any OpenAI-compatible endpoint. Primary choice: OpenAI (you have credits).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Leave LLM_BASE_URL empty for OpenAI's default endpoint.
LLM_BASE_URL=

# Also read as fallbacks if LLM_API_KEY is unset:
OPENAI_API_KEY=

# Hard caps so a slow/hung provider can never stall a request.
LLM_MAX_TOKENS=160
LLM_TIMEOUT_S=8
LLM_MAX_RETRIES=1

# --- Alternative providers (benchmark these, then pick the winner) --------
# Groq (fast open-weight inference; weaker Indic fluency):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
#   LLM_API_KEY=<groq key>
GROQ_API_KEY=
#
# Sarvam's own Indic-tuned LLM (reuses your Sarvam key):
#   LLM_BASE_URL=https://api.sarvam.ai/v1
#   LLM_MODEL=sarvam-m


# === Retrieval / serving configuration ====================================
# Query encoder. multilingual-e5-small (384d) is the latency+memory choice;
# BAAI/bge-m3 (1024d) is the quality reference. Must match the built index.
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_DIM=384
# torch | onnx   (`onnx` = int8-quantized CPU session, the fast serving path)
EMBED_BACKEND=onnx
# auto | cpu | cuda
EMBED_DEVICE=auto

# Dense index backend. hnswlib = in-process ANN (fastest, zero deploy risk).
# qdrant = Qdrant server over localhost gRPC (literal "vector DB" compliance).
INDEX_BACKEND=hnswlib
QDRANT_URL=http://127.0.0.1:6333
QDRANT_GRPC_PORT=6334

# Languages served, comma separated. Order is not significant.
RAG_LANGUAGES=hi,en,mr


# === Guardrail thresholds =================================================
# Refuse to answer when retrieval confidence is below these floors.
RAG_MIN_RELEVANCE=0.005
# Raw max cosine similarity floor (more interpretable than the RRF score).
RAG_MIN_COSINE=0.55
# Minimum groundedness of the generated answer against retrieved context.
RAG_MIN_GROUNDEDNESS=0.45


# === Deployment (Hugging Face Spaces) =====================================
# Dataset repo holding the prebuilt serve artifacts, downloaded at startup
# by backend/rag/bootstrap.py. Leave empty for local runs.
HHGOA_DATA_REPO=
HF_TOKEN=
